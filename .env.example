OPENAI_API_KEY=your_openai_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
API_URL=http://127.0.0.1:8000/telegram-ingest
BOT_DEFAULT_USER_ID=default
PROCESSOR_MODE=pipeline_b
SESSION_SECRET=replace_with_a_long_random_secret
PUBLIC_BASE_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=your_google_web_client_id
# Comma-separated Google account emails that see admin-only UI (users list, debug reel actions)
ADMIN_EMAILS=
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_INGEST_SECRET=replace_with_a_shared_secret_for_bot_and_backend

R2_BUCKET_NAME=reel-app-media
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_INDEX=clipnest_deep_search_reels_staging

# Apify (Instagram video fetching — primary downloader, yt-dlp is fallback)
APIFY_TOKEN=your_apify_token

# Demo access.
# DEMO_ACCOUNT_EMAIL picks the curated account both demo routes open. It must
# not be an admin account — both routes refuse one.
# DEMO_ACCESS_TOKEN (16+ chars) enables the private shareable link
#   /demo-login/<token>. Rotate it to kill a leaked link.
# DEMO_PUBLIC=on enables the token-free /try demo linked from the landing page,
#   and makes the "See it working" button appear. Read-only for visitors.
#   Its own switch, so turning it off does not break links already shared.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCESS_TOKEN=
DEMO_PUBLIC=

# Instagram user access token for the account that receives reel DMs.
# Without it the webhook can never learn a sender's @username: Instagram
# sends only an app-scoped numeric id (IGSID), so linked users show up
# nameless and cannot be matched to a person. Needs the scopes
# instagram_business_basic and instagram_business_manage_messages.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v25.0
